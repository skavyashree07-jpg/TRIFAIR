# Copy to .env and fill in. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep the existing local value if deployed seed data must preserve existing QR signatures.
TRIFAIR_QR_SECRET=
TRIFAIR_JWT_SECRET=
TRIFAIR_PAYMENT_SECRET=
# Optional
TRIFAIR_DB_URL=sqlite:///./trifair.db
TRIFAIR_DATA_DIR=../data
TRIFAIR_PLATFORM_FEE_PCT=5
TRIFAIR_VERIFY_RATE_LIMIT=30
TRIFAIR_SCAN_ALERT_THRESHOLD=20
TRIFAIR_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
TRIFAIR_PORT=8001
# Seed script: password for the demo users (random one is printed if unset)
TRIFAIR_DEMO_PASSWORD=
